# Cada proyecto tiene su propio .gitignore (api/.gitignore y app/.gitignore).
# Aquí solo archivos del sistema y del editor.
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# Registros de caídas de Java (daemon de Gradle sin memoria)
hs_err_pid*.log
replay_pid*.log

# Certificados y credenciales de bases externas (ej. ca.pem de Aiven)
*.pem
.env*
!.env.example

# Archivos de claves que se dejan a mano en el proyecto (contraseña de Aiven,
# APP_KEY de Railway, clave de Google…). NUNCA a git: el repo es público.
password.txt
appkey.txt
app_key.txt
apigoogle.txt
*clave*.txt
*secret*.txt
